WIDTH =600
HEIGHT = 600
TITLE = "Satelite"


list = []
lines = []

target = 0


for i in range(8):
    satelite = Actor("satelite.png")
    satelite.pos = random.randint(0, WIDTH-50),random.randint(0, HEIGHT-50)
    list.append(satelite)

def on_mouse_down(pos):
    global target
    global lines
    if list[target].collidepoint(pos):
        if target > 0:
            lines.append((list[target-1].pos,list[target].pos))
        target += 1
    
    else:  
        target = 0
        lines = []
    
    
       
